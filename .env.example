VITE_INGESTION_LEAD_URL=https://ykepcefnjurwdenmexgl.supabase.co/functions/v1/ingestion-lead

# Jeton d'entonnoir attendu par la fonction (en-tête X-Funnel-Token).
VITE_FUNNEL_TOKEN=jeton_provisoire_123
